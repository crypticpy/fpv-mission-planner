{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  // ADR 0009's ratchet: an explicit include list, seeded with modules that pass
  // clean under `strict` on their JSDoc alone. A file added here never leaves —
  // new modules land here on arrival, and existing ones join as their types are
  // written. `npm run typecheck` is a gate, not a report.
  "include": [
    "src/units.js",
    "src/geo.js",
    "src/store.js",
    "src/catalog/batteries.js",
    "src/catalog/drones.js",
    "src/catalog/manufacturers.js",
    "src/catalog/payloads.js",
    "src/catalog/scenarios.js",
    "src/catalog/weather.js"
  ]
}
